{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shelf-address",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	// The app is served only on its workers.dev address, which sits behind
	// Cloudflare Access (see README). Per-version preview URLs are switched
	// off so there's no second address to remember to protect.
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// Relational data: locations tree, editions cache, copies. Spec §2.
	// `database_id` comes from `npx wrangler d1 create shelf-address-db`.
	// See README "Connecting your Cloudflare account".
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shelf-address-db",
			"database_id": "6f4c325e-a375-42ab-a6c3-7271253f4fb1",
			"migrations_dir": "migrations"
		}
	],

	// Cover images (§2.2) and site reference maps (§5).
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "shelf-address-media"
		}
	]
}
